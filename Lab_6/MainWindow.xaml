<Window x:Class="Lab_6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STUDENT NOTIFICATIONS"
        Height="800"
        Width="1200"
        MinHeight="680"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#091D22"
        FontFamily="Segoe UI"
        Foreground="#E8FAFA">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2DD4BF"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#123039"/>
        <SolidColorBrush x:Key="InputBrush" Color="#1B4149"/>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#32616A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#08252B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A5CBCD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8FAFA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#173740"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#167E80"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="STUDENT NOTIFICATIONS"
                       Foreground="#5EEAD4"
                       FontSize="30"
                       FontWeight="Bold"/>
            <TextBlock Text="Події • Сповіщення деканату • Журнал змін оцінок"
                       Foreground="#91B9BD"
                       FontSize="13"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource PanelStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Керування студентами"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Ім'я та прізвище"
                                   Style="{StaticResource LabelStyle}"/>
                        <TextBox Style="{StaticResource InputStyle}"
                                 Text="{Binding StudentName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"/>

                        <Button Content="+ Додати студента"
                                Style="{StaticResource ButtonStyle}"
                                Command="{Binding AddStudentCommand}"/>

                        <TextBlock Text="Список студентів"
                                   Style="{StaticResource LabelStyle}"
                                   Margin="0,12,0,8"/>

                        <ListBox ItemsSource="{Binding Students}"
                                 SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                                 DisplayMemberPath="Name"
                                 Height="130"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding SelectedStudentInfo}"
                                   Foreground="#6AF0DE"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,0,0,18"/>

                        <Border Height="1"
                                Background="#32616A"
                                Margin="0,0,0,18"/>

                        <TextBlock Text="Керування оцінками"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="Оцінка (1–5)"
                                   Style="{StaticResource LabelStyle}"/>
                        <TextBox Style="{StaticResource InputStyle}"
                                 Text="{Binding MarkInput, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"/>

                        <Button Content="+ Додати оцінку"
                                Style="{StaticResource ButtonStyle}"
                                Command="{Binding AddMarkCommand}"/>

                        <TextBlock Text="Номер оцінки для зміни"
                                   Style="{StaticResource LabelStyle}"
                                   Margin="0,10,0,6"/>
                        <TextBox Style="{StaticResource InputStyle}"
                                 Text="{Binding MarkIndexInput, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"/>

                        <Button Content="Змінити оцінку"
                                Style="{StaticResource ButtonStyle}"
                                Background="#4DDCCB"
                                Command="{Binding UpdateMarkCommand}"/>

                        <Border Height="1"
                                Background="#32616A"
                                Margin="0,14,0,18"/>

                        <TextBlock Text="Підписки на події"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,16"/>

                        <CheckBox Content="Сповіщення деканату"
                                  IsChecked="{Binding DeanSubscribed, Mode=TwoWay}"/>

                        <CheckBox Content="Журнал змін оцінок"
                                  IsChecked="{Binding LoggerSubscribed, Mode=TwoWay}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <Button Content="Очистити попередження"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource ButtonStyle}"
                                    Background="#F0A5A5"
                                    Command="{Binding ClearWarningsCommand}"/>

                            <TextBlock Text="Сповіщення деканату"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Warnings}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <Button Content="Очистити журнал"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource ButtonStyle}"
                                    Background="#6DD8D4"
                                    Command="{Binding ClearLogsCommand}"/>

                            <TextBlock Text="Журнал подій"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding LogEntries}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="#123039"
                CornerRadius="10"
                Padding="14,12"
                Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="9"
                         Height="9"
                         Fill="#2DD4BF"
                         Margin="0,0,10,0"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#B5E5E2"
                           FontSize="13"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
